    {
      "parameters": {
        "chatId": "={{ $json.message.chat.id }}",
        "text": "=☕️ <b>Підтримати проєкт</b>\n\nПривіт! 👋 Я розробляю <b>Prompt Architect</b> сам, буквально «на колінці» у вільний час. Мені приємно, що бот допомагає вам отримувати круті результати від ШІ.\n\nАле є нюанс: оренда сервера та оплата токенів для нейромережі коштують реальних грошей. Кожен ваш запит — це маленька витрата для мене.\n\nЯкщо бот зекономив вам час або допоміг заробити — підтримайте проєкт гривнею. Будь-яка сума (навіть вартість однієї кави ☕️) допоможе боту залишатися онлайн і ставати кращим.\n\n<b>Оберіть зручний спосіб підтримки:</b> 👇",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "💳 Monobank",
                    "additionalFields": {
                      "url": "https://send.monobank.ua/jar/AbpdPUBdSt"
                    }
                  },
                  {
                    "text": "💳 Privatbank",
                    "additionalFields": {
                      "url": "https://www.privat24.ua/send/j2g68"
                    }
                  }
                ]
              }
            },
            {
              "row": {
