    {
      "parameters": {
        "jsCode": "const message = items[0].json.choices[0].message;\n\n// Функція, щоб безпечно дістати посилання з різних місць\nfunction getImageUrl(msg) {\n  // 1. Перевіряємо масив images (новий формат OpenRouter)\n  if (msg.images && msg.images.length > 0) {\n    const img = msg.images[0];\n    if (img.url) return img.url;                  // Варіант А\n    if (img.image_url && img.image_url.url) return img.image_url.url; // Варіант Б\n  }\n  // 2. Перевіряємо текст повідомлення (старий формат)\n  if (msg.content) {\n    const match = msg.content.match(/https?:\\/\\/[^\\s\\)]+/);\n    if (match) return match[0];\n  }\n  return null;\n}\n\nconst finalUrl = getImageUrl(message);\n\nif (finalUrl) {\n  // Якщо це Base64 код (картинка вже тут)\n  if (finalUrl.startsWith('data:')) {\n    const base64Data = finalUrl.split(',')[1];\n    return [{\n      json: { mode: \"binary\" },\n      binary: {\n        // 👇 УВАГА: Тут ми змінили 'data' на 'image_data'\n        image_data: {\n          data: base64Data,\n          mimeType: 'image/png',\n          fileName: 'generated_image.png'\n        }\n      }\n    }];\n  } \n  // Якщо це звичайне посилання http...\n  else {\n    return [{\n      json: { \n        mode: \"url\",\n        url: finalUrl \n      }\n    }];\n  }\n} else {\n  // Якщо нічого не знайшли\n  return [{ json: { error: \"Картинку не знайдено\", raw: message } }];\n}"
      },
