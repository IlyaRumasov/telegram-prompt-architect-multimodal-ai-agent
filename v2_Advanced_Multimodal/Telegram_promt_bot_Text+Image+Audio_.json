      "id": "26098a78-2769-45f3-b9f0-beaa8088785b",
      "name": "[TG] Dispatch Admin Alert / [TG] Відправка адмін-сповіщення",
      "webhookId": "YOUR_WEBHOOK_ID",
      "credentials": {
        "telegramApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Generic_API_Connection"
        }
      }
