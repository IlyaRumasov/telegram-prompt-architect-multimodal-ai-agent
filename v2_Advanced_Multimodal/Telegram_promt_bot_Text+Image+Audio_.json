        "jsCode": "const rawOutput = items[0].json.output;\n\n// Очистка від можливих ```json та ```\nconst cleanJson = rawOutput.replace(/^```json\\s*/, '').replace(/\\s*```$/, '').trim();\n\nlet parsedData;\ntry {\n  parsedData = JSON.parse(cleanJson);\n} catch (e) {\n  // Fallback: якщо AI помилився і не видав JSON, повертаємо все як текст\n  return [{\n      json: {\n          text_response: rawOutput, // Весь текст піде користувачу\n          image_prompt: \"A generic creative image representing artificial intelligence output\" // Заглушка для картинки\n      }\n  }];\n}\n\nreturn [{\n  json: {\n    text_response: parsedData.text_response,\n    image_prompt: parsedData.image_prompt\n  }\n}];"
