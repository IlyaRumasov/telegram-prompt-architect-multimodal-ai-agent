    {
      "parameters": {
        "chatId": "YOUR_ADMIN_CHAT_ID",
        "text": "=📩 <b>Новий запит у боті!</b>\n<b>Від:</b> @{{ $json.message.from.username || 'Анонім' }} (ID: <code>{{ $json.message.from.id }}</code>)\n<b>Текст:</b> {{ $json.message.text }}",
